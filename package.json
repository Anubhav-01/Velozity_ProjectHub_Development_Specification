{
  "name": "velozity-projecthub",
  "version": "1.0.0",
  "description": "Velozity ProjectHub — Real-time Agency Project Management Dashboard",
  "private": true,
  "scripts": {
    "postinstall": "npx prisma generate --schema=prisma/schema.prisma",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "start": "node scripts/start-production.js",
    "start:prod": "npx prisma db push --schema=prisma/schema.prisma && node server/dist/server.js",
    "test": "npm run test --workspace=server",
    "seed": "npm run seed --workspace=server",
    "db:migrate": "npx prisma migrate dev --schema=prisma/schema.prisma",
    "db:deploy": "npx prisma migrate deploy --schema=prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema=prisma/schema.prisma",
    "db:studio": "npx prisma studio --schema=prisma/schema.prisma",
    "db:reset": "npx prisma migrate reset --force --schema=prisma/schema.prisma"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "dependencies": {
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
